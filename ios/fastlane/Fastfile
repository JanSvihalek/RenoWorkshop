# Fastlane pro RenoWorkshop - podpis, build IPA a upload na TestFlight.
#
# Podpisové materiály spravuje `fastlane match`: certifikát i provisioning
# profil vzniknou na macOS runneru a uloží se zašifrované do privátního git
# repa. Vývojářský Mac tedy není potřeba.
#
# Lanes:
#   bootstrap  jednorázově - založí App ID + záznam v App Store Connect
#              a vygeneruje certifikát a profil do match repa
#   beta       po každém pushi - postaví IPA a nahraje ho do TestFlightu
#
# Proměnné prostředí (v CI ze secretů):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8      App Store Connect API klíč
#   MATCH_GIT_URL                              privátní repo s certifikáty
#   MATCH_GIT_BASIC_AUTHORIZATION              base64("uzivatel:PAT")
#   MATCH_PASSWORD                             heslo, kterým match šifruje
# Volitelné:
#   IOS_BUNDLE_ID, IOS_APP_NAME, IOS_SKU, BUILD_NUMBER

require "shellwords"

default_platform(:ios)

BUNDLE_ID = ENV["IOS_BUNDLE_ID"] || "dev.svihalek.renoworkshop"

# Kořen repozitáře - fastlane si mění pracovní adresář, tak radši absolutně.
PROJECT_ROOT = File.expand_path("../..", __dir__)

platform :ios do
  desc "Jednorázové založení App ID, aplikace v App Store Connect a podpisových materiálů"
  lane :bootstrap do
    key = asc_api_key

    # Založí bundle ID v Developer portálu a aplikaci v App Store Connect.
    # Když už existují, produce to jen oznámí a pokračuje.
    produce(
      api_key: key,
      app_identifier: BUNDLE_ID,
      app_name: ENV["IOS_APP_NAME"] || "RenoWorkshop",
      sku: ENV["IOS_SKU"] || BUNDLE_ID.tr(".", "-"),
      language: "Czech",
      skip_itc: false,
      skip_devcenter: false
    )

    # Vytvoří distribuční certifikát + App Store profil a uloží je
    # zašifrované do match repa (readonly: false = smí zapisovat).
    match(
      api_key: key,
      type: "appstore",
      app_identifier: BUNDLE_ID,
      readonly: false
    )

    UI.success("Hotovo. Další buildy už certifikát jen stahují z match repa.")
  end

  desc "Postaví podepsané IPA a nahraje ho do TestFlightu"
  lane :beta do
    key = asc_api_key

    # Dočasná klíčenka na runneru (na vlastním stroji se přeskočí).
    setup_ci if ENV["CI"]

    match(
      api_key: key,
      type: "appstore",
      app_identifier: BUNDLE_ID,
      readonly: true
    )

    profile_name = ENV["sigh_#{BUNDLE_ID}_appstore_profile-name"]
    team_id = ENV["sigh_#{BUNDLE_ID}_appstore_team-id"] || ENV["IOS_TEAM_ID"]
    UI.user_error!("match nevrátil jméno profilu - pusť lane `bootstrap`.") if profile_name.to_s.empty?
    UI.message("Podepisuji profilem '#{profile_name}' (team #{team_id}).")

    # Runner má po `flutter create` automatický podpis; přepneme ho na
    # manuální s profilem z matche.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: BUNDLE_ID,
      targets: ["Runner"]
    )

    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    # Flutter musí přeložit Dart kód a assety dřív, než se pustí xcodebuild.
    flutter_build = "flutter pub get && flutter build ios --release --no-codesign --build-number=#{build_number}"
    sh("cd #{PROJECT_ROOT.shellescape} && #{flutter_build}")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => profile_name },
        signingStyle: "manual",
        teamID: team_id
      },
      output_directory: "#{PROJECT_ROOT}/build/ios/ipa",
      output_name: "RenoWorkshop.ipa",
      clean: false
    )

    # skip_waiting_for_build_processing: CI nečeká ~10 minut na zpracování
    # buildu Applem. Cenou je, že se nedá nastavit changelog - kdyby byl
    # potřeba, přepni flag na false a doplň `changelog:`.
    upload_to_testflight(
      api_key: key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end

# API klíč místo Apple ID s dvoufázovým ověřením.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    in_house: false
  )
end
